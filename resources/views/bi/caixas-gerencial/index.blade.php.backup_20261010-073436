<script>
document.addEventListener('DOMContentLoaded', () => {

    'use strict';

    const URL_DADOS = @json(route('bi.caixas-gerencial.dados'));
    const URL_DETALHES = @json(route('bi.caixas-gerencial.detalhes', ['caixa' => 999999]));
    const INTERVALO = 20000;

    const ORDEM = [
        ['dinheiro', 'Dinheiro'],
        ['pix', 'PIX'],
        ['cartao_debito', 'Cartão de Débito'],
        ['cartao_credito', 'Cartão de Crédito'],
        ['carteira', 'Carteira']
    ];

    const moeda = valor => Number(valor || 0).toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
    });

    const seguro = valor => String(valor ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

    const dataHora = valor => {
        if (!valor) return '—';
        const d = new Date(String(valor).replace(' ', 'T'));
        return isNaN(d.getTime())
            ? seguro(valor)
            : d.toLocaleString('pt-BR');
    };

    const hora = valor => {
        if (!valor) return '—';
        const d = new Date(String(valor).replace(' ', 'T'));
        return isNaN(d.getTime())
            ? seguro(valor)
            : d.toLocaleTimeString('pt-BR');
    };

    const duracao = valor => {
        if (!valor) return '—';
        const inicio = new Date(String(valor).replace(' ', 'T'));
        const segundos = Math.max(0, Math.floor(
            (Date.now() - inicio.getTime()) / 1000
        ));
        if (!Number.isFinite(segundos)) return '—';
        const h = Math.floor(segundos / 3600);
        const m = Math.floor((segundos % 3600) / 60);
        const s = segundos % 60;
        return `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`;
    };

    const linha = (nome, valor) => `
        <div class="bi09-linha">
            <span>${seguro(nome)}</span>
            <strong>${seguro(valor)}</strong>
        </div>`;

    let executando = false;
    let ultimaResposta = null;
    let ultimoModo = 'abertos';

    const modo = document.getElementById('bi09-modo');
    const cards = document.getElementById('bi09-cards');
    const consolidado = document.getElementById('bi09-consolidado');
    const status = document.getElementById('bi09-status');
    const avisos = document.getElementById('bi09-avisos');

    function renderCard(c) {

        const formas = ORDEM.map(([key, label]) =>
            linha(label, moeda(c.formas[key]))
        ).join('');

        const aberto = c.status === 'aberto';
        const tempo = aberto
            ? duracao(c.abertura)
            : 'Encerrado';

        const sugerida = c.sangria_sugerida === null
            ? 'Não configurada'
            : moeda(c.sangria_sugerida);

        const saldo = c.saldo_dinheiro === null
            ? '—'
            : moeda(c.saldo_dinheiro);

        return `
        <div class="col-12 col-md-6 col-xl-4">
          <div class="card bi09-card h-100 shadow-sm">

            <div class="card-header p-3">
              <div class="d-flex justify-content-between gap-2">
                <div>
                  <h5 class="fw-bold mb-1">Caixa ${seguro(c.id)}</h5>
                  <div class="small text-muted">${seguro(c.terminal || 'Terminal não informado')}</div>
                </div>
                <span class="badge align-self-start ${aberto ? 'bg-success' : 'bg-secondary'}">
                  ${aberto ? 'Aberto' : seguro(c.status)}
                </span>
              </div>

              <div class="small mt-3">
                <strong>Operador:</strong> ${seguro(c.operador)}
                <span class="text-muted">(#${seguro(c.user_id)})</span>
              </div>

              <hr class="my-2">

              <div class="row g-2 small">
                <div class="col-6">
                  <div class="bi09-label">Abertura</div>
                  <strong>${dataHora(c.abertura)}</strong>
                </div>
                <div class="col-6">
                  <div class="bi09-label">Tempo em aberto</div>
                  <strong class="bi09-cronometro"
                          data-abertura="${seguro(c.abertura)}"
                          data-aberto="${aberto ? 1 : 0}">
                    ${tempo}
                  </strong>
                </div>
                <div class="col-12">
                  <div class="bi09-label">Última venda</div>
                  <strong>${hora(c.ultima_venda)}</strong>
                </div>
              </div>
            </div>

            <div class="card-body p-3">

              <div class="d-flex justify-content-between mb-3">
                <strong>Formas de pagamento</strong>
                <span class="badge bg-light text-dark border">
                  ${seguro(c.quantidade_vendas)} vendas
                </span>
              </div>

              ${formas}

              <div class="bi09-section-title mt-4 mb-3">
                Controle de sangrias
              </div>

              <div class="bi09-bloco">
                ${linha('Sangrias realizadas', String(c.sangrias_quantidade))}
                ${linha('Total retirado', moeda(c.sangrias_total))}
                ${linha('Última sangria', hora(c.ultima_sangria))}
                ${linha('Sangria a realizar', sugerida)}
                ${linha('Dinheiro estimado', saldo)}
              </div>

            </div>

            <div class="card-footer p-3 mt-auto">
              <div class="bi09-label fw-bold">TOTAL DO CAIXA</div>
              <div class="bi09-valor">${moeda(c.total)}</div>
              <button class="btn btn-outline-primary w-100 mt-3"
                      type="button"
                      data-bi09-detalhes="${seguro(c.id)}">
                Ver detalhes
              </button>
            </div>

          </div>
        </div>`;
    }

    function renderConsolidado(d) {

        const itens = ORDEM.map(([key, label]) =>
            `<div class="col-md-6">${linha(label, moeda(d.formas[key]))}</div>`
        ).join('');

        consolidado.innerHTML = `
          <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
              <div class="bi09-bloco">
                <div class="bi09-label">Caixas exibidos</div>
                <h4 class="mb-0">${seguro(d.caixas)}</h4>
              </div>
            </div>
            <div class="col-6 col-xl-3">
              <div class="bi09-bloco">
                <div class="bi09-label">Vendas realizadas</div>
                <h4 class="mb-0">${seguro(d.vendas_quantidade)}</h4>
              </div>
            </div>
            <div class="col-6 col-xl-3">
              <div class="bi09-bloco">
                <div class="bi09-label">Sangrias realizadas</div>
                <h5 class="mb-0">${moeda(d.sangrias_total)}</h5>
                <small>${seguro(d.sangrias_quantidade)} operações</small>
              </div>
            </div>
            <div class="col-6 col-xl-3">
              <div class="bi09-bloco">
                <div class="bi09-label">Sangrias a realizar</div>
                <h5 class="mb-0">${moeda(d.sangrias_sugeridas)}</h5>
              </div>
            </div>
          </div>

          <div class="bi09-section-title mb-3">
            Totais por forma de pagamento
          </div>

          <div class="row g-2 mb-4">${itens}</div>

          <div class="p-4 rounded"
               style="background:#eaf7ee;border:1px solid #cfe8d5">
            <div class="small fw-bold text-success">
              TOTAL GERAL DOS CAIXAS EXIBIDOS
            </div>
            <div class="bi09-valor fs-2">${moeda(d.total)}</div>
          </div>`;
    }

    async function atualizar() {
        if (executando) return;

        executando = true;

        try {
            const parametros = new URLSearchParams({
                modo: modo.value
            });

            if (modo.value === 'historico') {
                parametros.set('data_inicio',
                    document.getElementById('bi09-inicio').value);
                parametros.set('data_fim',
                    document.getElementById('bi09-fim').value);
            }

            const resposta = await fetch(
                URL_DADOS + '?' + parametros.toString(),
                {
                    cache: 'no-store',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                }
            );

            if (!resposta.ok) {
                throw new Error(`HTTP ${resposta.status}`);
            }

            const dados = await resposta.json();

            ultimaResposta = dados;
            ultimoModo = modo.value;

            cards.innerHTML = dados.caixas.length
                ? dados.caixas.map(renderCard).join('')
                : `<div class="col-12">
                     <div class="card">
                       <div class="card-body text-center py-5 text-muted">
                         Nenhum caixa encontrado nesta visualização.
                       </div>
                     </div>
                   </div>`;

            renderConsolidado(dados.consolidado);

            if (dados.avisos?.length) {
                avisos.classList.remove('d-none');
                avisos.textContent = dados.avisos.join(' | ');
            } else {
                avisos.classList.add('d-none');
                avisos.textContent = '';
            }

            status.className = 'badge bg-success';
            status.textContent = 'Sincronizado';

            document.getElementById('bi09-ultima-atualizacao')
                .textContent = new Date().toLocaleTimeString('pt-BR');

        } catch (erro) {
            console.error('BI-09:', erro);
            status.className = 'badge bg-danger';
            status.textContent = 'Falha de sincronização';
        } finally {
            executando = false;
        }
    }

    async function abrirDetalhes(id) {
        const url = URL_DETALHES.replace('999999', encodeURIComponent(id));

        document.getElementById('bi09-modal-titulo')
            .textContent = `Caixa ${id} — Histórico`;

        const conteudo = document.getElementById('bi09-modal-conteudo');
        conteudo.textContent = 'Carregando movimentações...';

        const modal = bootstrap.Modal.getOrCreateInstance(
            document.getElementById('bi09-modal')
        );
        modal.show();

        try {
            const resposta = await fetch(url, {
                cache: 'no-store',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });

            if (!resposta.ok) throw new Error('Falha na consulta');

            const dados = await resposta.json();

            const linhas = dados.movimentacoes.map(m => `
                <tr>
                  <td>${dataHora(m.data_movimentacao)}</td>
                  <td>${seguro(m.tipo)}</td>
                  <td>${seguro(m.forma_pagamento || '—')}</td>
                  <td>${seguro(m.operador || '—')}</td>
                  <td class="text-end">${moeda(m.valor)}</td>
                </tr>
            `).join('');

            conteudo.innerHTML = `
                <div class="table-responsive">
                  <table class="table table-striped table-sm align-middle">
                    <thead>
                      <tr>
                        <th>Data / hora</th>
                        <th>Movimentação</th>
                        <th>Forma</th>
                        <th>Operador</th>
                        <th class="text-end">Valor</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${linhas || '<tr><td colspan="5">Sem movimentações.</td></tr>'}
                    </tbody>
                  </table>
                </div>
                <div class="small text-muted">
                  Exibindo até 150 movimentações mais recentes.
                </div>`;

        } catch (erro) {
            conteudo.textContent = 'Não foi possível carregar os detalhes.';
        }
    }

    document.addEventListener('click', evento => {
        const botao = evento.target.closest('[data-bi09-detalhes]');
        if (botao) abrirDetalhes(botao.dataset.bi09Detalhes);
    });

    document.getElementById('bi09-filtros')
        .addEventListener('submit', evento => {
            evento.preventDefault();
            atualizar();
        });

    modo.addEventListener('change', () => {
        document.querySelectorAll('.bi09-periodo').forEach(el => {
            el.classList.toggle('d-none', modo.value !== 'historico');
        });
        atualizar();
    });

    // Relogio local: 1 segundo
    setInterval(() => {
        document.querySelectorAll('.bi09-cronometro').forEach(el => {
            if (el.dataset.aberto === '1') {
                el.textContent = duracao(el.dataset.abertura);
            }
        });
    }, 1000);

    // Monitoramento de rede: 20 segundos
    setInterval(() => {
        if (modo.value === 'abertos') atualizar();
    }, INTERVALO);

    atualizar();
});
</script>
@endsection