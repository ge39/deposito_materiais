<script>
document.addEventListener('DOMContentLoaded', () => {

    'use strict';

    const DADOS_URL = @json(route('bi.caixas-gerencial.dados'));
    const DETALHES_BASE = @json(route('bi.caixas-gerencial.detalhes', ['caixa' => 999999]));

    const INTERVALO = 20000;

    const FORMAS = [
        ['dinheiro', 'Dinheiro'],
        ['pix', 'PIX'],
        ['cartao_debito', 'Cartão de Débito'],
        ['cartao_credito', 'Cartão de Crédito'],
        ['carteira', 'Carteira']
    ];

    const raiz = document.getElementById('bi09-app');
    const cards = document.getElementById('bi09-cards');
    const resumo = document.getElementById('bi09-consolidado-body');

    const btnVivo = document.getElementById('bi09-ao-vivo');
    const btnHistorico = document.getElementById('bi09-historico');
    const areaDatas = document.getElementById('bi09-area-datas');

    let modo = 'abertos';
    let carregando = false;
    let requisicao = 0;
    let tokenConsulta = 0;

    function moeda(n) {
        return Number(n || 0).toLocaleString('pt-BR', {
            style: 'currency',
            currency: 'BRL'
        });
    }

    function esc(v) {
        return String(v ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function data(v) {
        if (!v) return '—';
        const d = new Date(String(v).replace(' ', 'T'));
        return isNaN(d.getTime())
            ? esc(v)
            : d.toLocaleString('pt-BR');
    }

    function hora(v) {
        if (!v) return '—';
        const d = new Date(String(v).replace(' ', 'T'));
        return isNaN(d.getTime())
            ? esc(v)
            : d.toLocaleTimeString('pt-BR', {
                hour: '2-digit',
                minute: '2-digit'
            });
    }

    function tempo(v) {
        if (!v) return '—';

        const d = new Date(String(v).replace(' ', 'T'));
        if (isNaN(d.getTime())) return '—';

        const seg = Math.max(0, Math.floor(
            (Date.now() - d.getTime()) / 1000
        ));

        const h = Math.floor(seg / 3600);
        const m = Math.floor((seg % 3600) / 60);
        const s = seg % 60;

        return `${String(h).padStart(2,'0')}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`;
    }

    function pagamento(nome, valor) {
        return `
            <div class="bi09-pagamento">
                <span class="bi09-pagamento-label">${esc(nome)}</span>
                <span class="bi09-pagamento-valor">${moeda(valor)}</span>
            </div>`;
    }

    function kpi(nome, valor, classe, complemento = '') {
        return `
            <div class="bi09-kpi ${classe}">
                <div class="bi09-kpi-label">${esc(nome)}</div>
                <div class="bi09-kpi-value">${esc(valor)}</div>
                ${complemento ? `<div class="bi09-kpi-sub">${esc(complemento)}</div>` : ''}
            </div>`;
    }

    function caixaHtml(c) {

        const aberto = c.status === 'aberto';

        const statusClasse = aberto
            ? 'bi09-status-aberto'
            : 'bi09-status-fechado';

        const pagamentos = FORMAS.map(([chave, nome]) =>
            pagamento(nome, c.formas?.[chave] || 0)
        ).join('');

        const sugerida = c.sangria_sugerida === null
            ? 'Não configurada'
            : moeda(c.sangria_sugerida);

        const saldo = c.saldo_dinheiro === null
            ? 'Não disponível'
            : moeda(c.saldo_dinheiro);

        return `
        <div class="col-12 col-md-6 col-xl-4">
            <div class="bi09-caixa">

                <!-- HEADER -->
                <div class="bi09-card-header">

                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="bi09-caixa-nome">
                                Caixa ${esc(c.id)}
                            </div>
                            <div class="text-muted small mt-1">
                                ${esc(c.terminal || 'Terminal não identificado')}
                            </div>
                        </div>

                        <span class="${statusClasse}">
                            ${aberto ? '● Aberto' : esc(c.status)}
                        </span>
                    </div>

                    <div class="bi09-operador">
                        <strong>Operador:</strong>
                        ${esc(c.operador)}
                        <span class="text-muted">
                            (USR-${esc(c.user_id)})
                        </span>
                    </div>

                    <div class="bi09-metadata">

                        <div class="bi09-meta">
                            <div class="bi09-meta-label">Abertura</div>
                            <div class="bi09-meta-value">
                                ${data(c.abertura)}
                            </div>
                        </div>

                        <div class="bi09-meta">
                            <div class="bi09-meta-label">Tempo em aberto</div>
                            <div class="bi09-meta-value bi09-tempo"
                                 data-abertura="${esc(c.abertura)}"
                                 data-aberto="${aberto ? 1 : 0}">
                                ${aberto ? tempo(c.abertura) : 'Encerrado'}
                            </div>
                        </div>

                        <div class="bi09-meta">
                            <div class="bi09-meta-label">Última venda</div>
                            <div class="bi09-meta-value">
                                ${hora(c.ultima_venda)}
                            </div>
                        </div>

                    </div>

                </div>

                <!-- BODY: DUAS COLUNAS INTERNAS -->
                <div class="bi09-card-body">

                    <div class="bi09-painel">

                        <div class="bi09-painel-head">
                            Formas de pagamento
                            <div class="fw-normal mt-1">
                                ${esc(c.quantidade_vendas)} venda(s)
                            </div>
                        </div>

                        <div class="bi09-painel-content">
                            ${pagamentos}
                        </div>

                    </div>

                    <div class="bi09-painel">

                        <div class="bi09-painel-head">
                            Controle de sangrias
                        </div>

                        <div class="bi09-sangrias-content">

                            ${kpi(
                                'Sangrias realizadas',
                                moeda(c.sangrias_total),
                                'bi09-kpi-blue',
                                c.sangrias_quantidade + ' operação(ões)'
                            )}

                            ${kpi(
                                'Sangria a realizar',
                                sugerida,
                                'bi09-kpi-warning'
                            )}

                            ${kpi(
                                'Última sangria',
                                hora(c.ultima_sangria),
                                'bi09-kpi-neutral'
                            )}

                            ${kpi(
                                'Dinheiro estimado em caixa',
                                saldo,
                                'bi09-kpi-green'
                            )}

                        </div>
                    </div>

                </div>

                <!-- FOOTER -->
                <div class="bi09-card-footer">

                    <div class="bi09-total-caixa">
                        <span class="bi09-total-label">
                            TOTAL DO CAIXA
                        </span>
                        <strong class="bi09-total-valor">
                            ${moeda(c.total)}
                        </strong>
                    </div>

                    <button type="button"
                            class="bi09-detalhes-btn"
                            data-caixa-id="${esc(c.id)}">
                        Ver detalhes
                    </button>

                </div>

            </div>
        </div>`;
    }

    function resumoCard(titulo, valor, classe) {
        return `
        <div class="col-6 col-xl-3">
            <div class="bi09-resumo ${classe}">
                <div class="bi09-resumo-label">${esc(titulo)}</div>
                <div class="bi09-resumo-valor">${esc(valor)}</div>
            </div>
        </div>`;
    }

    function consolidadoHtml(d) {

        const formas = FORMAS.map(([chave, nome]) => `
            <div class="bi09-consolidado-forma">
                <span>${esc(nome)}</span>
                <strong>${moeda(d.formas?.[chave] || 0)}</strong>
            </div>
        `).join('');

        return `
            <div class="row g-2 mb-3">

                ${resumoCard(
                    'Caixas em operação / exibidos',
                    String(d.caixas),
                    'bi09-resumo-green'
                )}

                ${resumoCard(
                    'Vendas realizadas',
                    String(d.vendas_quantidade),
                    ''
                )}

                ${resumoCard(
                    'Sangrias realizadas',
                    moeda(d.sangrias_total),
                    'bi09-resumo-purple'
                )}

                ${resumoCard(
                    'Sangrias a realizar',
                    moeda(d.sangrias_sugeridas),
                    'bi09-resumo-orange'
                )}

            </div>

            <div class="row g-3 align-items-stretch">

                <div class="col-12 col-lg-7">
                    <div class="fw-semibold small mb-2">
                        Totais por forma de pagamento
                    </div>
                    <div class="row gx-4">
                        <div class="col-md-6">
                            ${FORMAS.slice(0,3).map(([chave,nome]) => `
                                <div class="bi09-consolidado-forma">
                                    <span>${esc(nome)}</span>
                                    <strong>${moeda(d.formas?.[chave] || 0)}</strong>
                                </div>
                            `).join('')}
                        </div>
                        <div class="col-md-6">
                            ${FORMAS.slice(3).map(([chave,nome]) => `
                                <div class="bi09-consolidado-forma">
                                    <span>${esc(nome)}</span>
                                    <strong>${moeda(d.formas?.[chave] || 0)}</strong>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="bi09-total-geral">
                        <div class="bi09-total-geral-label">
                            TOTAL GERAL DOS CAIXAS EXIBIDOS
                        </div>
                        <div class="bi09-total-geral-valor">
                            ${moeda(d.total)}
                        </div>
                    </div>
                </div>

            </div>`;
    }

    async function atualizar() {

        if (carregando) return;

        carregando = true;

        const token = tokenConsulta;
        const modoConsulta = modo;

        try {

            const params = new URLSearchParams({
                modo: modoConsulta
            });

            if (modoConsulta === 'historico') {
                params.set(
                    'data_inicio',
                    document.getElementById('bi09-data-inicio').value
                );
                params.set(
                    'data_fim',
                    document.getElementById('bi09-data-fim').value
                );
            }

            const resposta = await fetch(
                DADOS_URL + '?' + params.toString(),
                {
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: {
                        'Accept': 'application/json'
                    }
                }
            );

            if (!resposta.ok) {
                throw new Error('HTTP ' + resposta.status);
            }

            const dados = await resposta.json();

            if (token !== tokenConsulta || modoConsulta !== modo) return;

            cards.innerHTML = dados.caixas.length
                ? dados.caixas.map(caixaHtml).join('')
                : `<div class="col-12">
                    <div class="bi09-toolbar text-center py-5 text-muted">
                        Nenhum caixa encontrado.
                    </div>
                   </div>`;

            resumo.innerHTML = consolidadoHtml(dados.consolidado);

            document.getElementById('bi09-sincronizado')
                .textContent = new Date().toLocaleTimeString('pt-BR');

            const status = document.getElementById('bi09-status');
            status.textContent = 'Atualização automática: 20 s';

            document.getElementById('bi09-status-dot')
                .style.background = '#198754';

            const avisos = document.getElementById('bi09-avisos');

            if (dados.avisos && dados.avisos.length) {
                avisos.textContent = dados.avisos.join(' | ');
                avisos.classList.remove('d-none');
            } else {
                avisos.textContent = '';
                avisos.classList.add('d-none');
            }

        } catch (erro) {

            console.error('BI-09:', erro);

            document.getElementById('bi09-status').textContent =
                'Falha de sincronização';

            document.getElementById('bi09-status-dot')
                .style.background = '#dc3545';

        } finally {
            carregando = false;
        }
    }

    async function detalhes(id) {

        const corpo = document.getElementById('bi09-modal-body');
        const titulo = document.getElementById('bi09-modal-title');

        titulo.textContent = 'Caixa ' + id + ' — Movimentações';
        corpo.textContent = 'Carregando...';

        const modal = bootstrap.Modal.getOrCreateInstance(
            document.getElementById('bi09-modal')
        );

        modal.show();

        try {

            const url = DETALHES_BASE.replace(
                '999999',
                encodeURIComponent(id)
            );

            const resposta = await fetch(url, {
                cache: 'no-store',
                credentials: 'same-origin',
                headers: {'Accept':'application/json'}
            });

            if (!resposta.ok) throw new Error('HTTP ' + resposta.status);

            const dados = await resposta.json();

            const linhas = dados.movimentacoes.map(m => `
                <tr>
                    <td>${data(m.data_movimentacao)}</td>
                    <td>${esc(m.tipo)}</td>
                    <td>${esc(m.forma_pagamento || '—')}</td>
                    <td>${esc(m.operador || '—')}</td>
                    <td class="text-end">${moeda(m.valor)}</td>
                </tr>
            `).join('');

            corpo.innerHTML = `
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Data / hora</th>
                                <th>Movimentação</th>
                                <th>Forma</th>
                                <th>Operador</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${linhas || '<tr><td colspan="5">Sem movimentações</td></tr>'}
                        </tbody>
                    </table>
                </div>
                <div class="small text-muted">
                    Até 150 movimentações recentes.
                </div>`;

        } catch (e) {
            corpo.textContent = 'Erro ao consultar movimentações.';
        }
    }

    document.addEventListener('click', evento => {

        const botao = evento.target.closest('[data-caixa-id]');

        if (botao) {
            detalhes(botao.dataset.caixaId);
        }
    });

    function selecionarModo(novoModo) {

        modo = novoModo;
        tokenConsulta++;

        btnVivo.className = novoModo === 'abertos'
            ? 'btn btn-primary btn-sm bi09-mode active'
            : 'btn btn-outline-secondary btn-sm bi09-mode';

        btnHistorico.className = novoModo === 'historico'
            ? 'btn btn-primary btn-sm bi09-mode active'
            : 'btn btn-outline-secondary btn-sm bi09-mode';

        areaDatas.classList.toggle('d-none', novoModo !== 'historico');

        atualizarQuandoLivre();
    }

    function atualizarQuandoLivre() {
        if (carregando) {
            const aguardando = setInterval(() => {
                if (!carregando) {
                    clearInterval(aguardando);
                    atualizar();
                }
            }, 100);
        } else {
            atualizar();
        }
    }

    btnVivo.addEventListener('click', () => selecionarModo('abertos'));
    btnHistorico.addEventListener('click', () => selecionarModo('historico'));

    document.getElementById('bi09-aplicar')
        .addEventListener('click', atualizarQuandoLivre);

    // Cronometro atualizado a cada segundo.
    setInterval(() => {
        document.querySelectorAll('.bi09-tempo').forEach(el => {
            if (el.dataset.aberto === '1') {
                el.textContent = tempo(el.dataset.abertura);
            }
        });
    }, 1000);

    // Consulta automatica ao servidor a cada 20 segundos.
    setInterval(() => {
        if (modo === 'abertos') atualizar();
    }, INTERVALO);

    atualizar();

});
</script>

@endsection