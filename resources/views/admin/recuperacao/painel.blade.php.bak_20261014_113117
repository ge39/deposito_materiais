<script>
const rec01Data = @json([
    'banco' => $banco,
    'tabela' => $tabela,
    'presente' => $presente,
    'tabelaAlternativa' => $tabelaAlternativa,
    'diagnosticoConcluido' => $diagnosticoConcluido,
    'relacionamentos' => count($dependencias),
    'backups' => array_column($backups, 'nome')
]);

async function copiarDiagnostico() {
    const linhas = [
        'REC-01 - Diagnóstico técnico',
        'Banco: ' + (rec01Data.banco || 'Não identificado'),
        'Tabela esperada: ' + rec01Data.tabela,
        'Diagnóstico concluído: ' +
            (rec01Data.diagnosticoConcluido ? 'Sim' : 'Não'),
        'Tabela presente: ' +
            (rec01Data.diagnosticoConcluido
                ? (rec01Data.presente ? 'Sim' : 'Não')
                : 'Não confirmado'),
        'Tabela alternativa: ' +
            (rec01Data.tabelaAlternativa ? 'orcamento' : 'Não'),
        'Relacionamentos: ' + rec01Data.relacionamentos,
        'Backups localizados: ' +
            rec01Data.backups.join(', '),
        'Restauração executada: Não'
    ];

    const msg = document.getElementById('rec01-msg');

    try {
        await navigator.clipboard.writeText(linhas.join('\n'));
        msg.className = 'mt-3 small text-success';
        msg.textContent = 'Diagnóstico copiado com sucesso.';
    } catch (error) {
        msg.className = 'mt-3 small text-danger';
        msg.textContent = 'Não foi possível copiar o relatório.';
    }
}
</script>

